# Copy this file to .env and fill in real values. Never commit .env.

# Path to your Firebase service account JSON (Firebase Console ->
# Project Settings -> Service Accounts -> Generate new private key).
# Save that downloaded file in the project root as serviceAccountKey.json
# (already in .gitignore) or point this at wherever you keep it.
FIREBASE_SERVICE_ACCOUNT_KEY=serviceAccountKey.json

# Port the Flask app runs on.
PORT=5000

# Gemini API key used by the AI Tutor feature (dashboard.html).
GEMINI_API_KEY=AQ.Ab8RN6LIelf_XtAl768z3KAzCaO6p8pd2LedEqjVxqMnQuhqzA
GEMINI_MODEL=gemini-1.5-flash
