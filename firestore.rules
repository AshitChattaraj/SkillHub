rules_version = '2';

// Paste this into Firebase Console -> Firestore Database -> Rules.
// This is what enforces "student vs admin" server-side. User signup cannot
// create an admin profile; administrators are provisioned separately.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // ---- Users / roles ----
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());

      // A user can create their own profile doc (signup) but cannot
      // set themselves to admin that way — role on create must be
      // "student" unless an admin is doing the writing.
      allow create: if isSignedIn() && request.auth.uid == uid &&
        (request.resource.data.role == "student" || isAdmin());

      // Users can update their own profile fields (photo, name, academic details);
      // Only admins can alter role or status.
      allow update: if isSignedIn() && (
        (request.auth.uid == uid && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status']) || resource.data.role == request.resource.data.role))
        || isAdmin()
      );

      allow delete: if isAdmin();
    }

    // ---- Official Admin Announcements / Notifications ----
    match /announcements/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // ---- Courses / Folders / Materials ----
    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();

      match /folders/{folderId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();

        match /materials/{materialId} {
          allow read: if isSignedIn();
          allow write: if isAdmin();
        }
      }

      // Students can rate a course, but only their own rating doc.
      match /ratings/{raterUid} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && request.auth.uid == raterUid;
      }
    }

    // ---- Admin-managed content libraries (Videos / PDFs / GATE) ----
    match /library_videos/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /library_pdfs/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---- Per-user private data: progress, bookmarks, AI chats, resume checks ----
    match /users/{uid}/progress/{materialId} {
      allow read, write: if isSignedIn() && (request.auth.uid == uid || isAdmin());
    }
    match /users/{uid}/bookmarks/{courseId} {
      allow read, write: if isSignedIn() && (request.auth.uid == uid || isAdmin());
    }
    match /users/{uid}/aiChats/{chatId} {
      allow read, create: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow update, delete: if isAdmin();
    }
    match /users/{uid}/resumeChecks/{checkId} {
      allow read, create: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // ---- Activity log: any signed-in user can log their own events;
    //      only admins can read the full feed (used for Data Records).
    //      A user can read their own events too (Downloads/History pages).
    match /activity/{eventId} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // ---- Certificates: system-issued on 100% completion. Students can
    //      read their own; only the owning student (via client logic) or
    //      an admin can create one; nobody edits/deletes but admins.
    match /certificates/{certId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}
